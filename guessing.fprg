
<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="guessing"/>
        <attribute name="authors" value="Seth"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2024-12-11 03:20:41 PM"/>
        <attribute name="created" value="U2V0aDtERVNLVE9QLUVSRDZKSUk7MjAyNC0xMS0xNzswNDo1MTo0OCBQTTsyNzY0"/>
        <attribute name="edited" value="U2V0aDtERVNLVE9QLUVSRDZKSUk7MjAyNC0xMi0xMTswMzoyMDo0MSBQTTsyOzI4NTY="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="RandomNumber" type="Integer" array="False" size=""/>
            <declare name="UserGuess" type="Integer" array="False" size=""/>
            <assign variable="RandomNumber" expression="Random(10)"/>
            <output expression="&quot;Enter a number between 0-9&quot;" newline="True"/>
            <input variable="UserGuess"/>
            <while expression="UserGuess &lt;&gt; RandomNumber">
                <output expression="&quot;Incorrect! Try again: Enter a number between 0-9&quot;" newline="True"/>
                <input variable="UserGuess"/>
            </while>
            <output expression="&quot;Correct! Thank you for playing!&quot;" newline="True"/>
        </body>
    </function>
</flowgorithm>
